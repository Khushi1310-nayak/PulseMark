# PulseMark Environment Configuration

# API Port & Host
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Frontend API URL (for production or custom port)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Database (PostgreSQL / Neon - Optional, defaults to zero-config resilient in-memory store)
# DATABASE_URL="postgresql://user:password@localhost:5432/pulsemark?schema=public"

# Redis Cache (Upstash / Local Redis - Optional, defaults to zero-config in-memory cache)
# REDIS_URL="redis://localhost:6379"
# UPSTASH_REDIS_URL="rediss://default:xxx@xxx.upstash.io:6379"
